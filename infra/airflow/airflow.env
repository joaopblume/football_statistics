# Airflow Environment Variables
AIRFLOW_HOME=/root/airflow

# MinIO credentials for DAG tasks (lib/minio_config.get_minio_settings reads these).
# LOCAL-DEV defaults — override in any real deployment, or switch Airflow to a
# secrets backend (Vault / AWS Secrets Manager). Not application code: kept here
# so systemd's EnvironmentFile injects them into the Airflow processes.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# --- Observability (OpenTelemetry → otel-collector) ---
# Exports Airflow metrics + traces to the OTel Collector over OTLP gRPC.
# Enable AFTER:  pip install 'apache-airflow[otel]'  &&  make obs-up
# (left OFF by default so Airflow doesn't log export errors before the
#  collector is up). Flip the two OTEL_ON values to True to enable.
AIRFLOW__METRICS__OTEL_ON=True
AIRFLOW__METRICS__OTEL_HOST=localhost
AIRFLOW__METRICS__OTEL_PORT=4317
AIRFLOW__METRICS__OTEL_SERVICE=airflow
AIRFLOW__METRICS__OTEL_INTERVAL_MILLISECONDS=30000
AIRFLOW__TRACES__OTEL_ON=True
AIRFLOW__TRACES__OTEL_HOST=localhost
AIRFLOW__TRACES__OTEL_PORT=4317
AIRFLOW__TRACES__OTEL_APPLICATION=airflow

# --- Lineage (OpenLineage; lightweight, no Marquez) ---
# Emits run/job/dataset lineage events. The 'file' transport persists them as
# JSONL (swap to {"type":"http","url":"http://marquez:5000"} to ship to Marquez).
AIRFLOW__OPENLINEAGE__NAMESPACE=football_pipeline
AIRFLOW__OPENLINEAGE__TRANSPORT={"type":"file","log_file_path":"/root/airflow/openlineage/events.jsonl"}
