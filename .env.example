# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# These variables configure the pipeline's data stores. In a real deployment,
# prefer an Airflow secrets backend (Vault / AWS Secrets Manager) over a file.

# --- PostgreSQL (serving layer + Airflow metadata DB) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=futebol-dados
PGUSER=postgres
PGPASSWORD=change-me

# --- MinIO / S3A object storage ---
# Read by Airflow DAG tasks via lib/minio_config.get_minio_settings() and
# injected into the MinIO + Spark containers by docker-compose.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
# Root credentials for the MinIO *server* container (infra/minio/docker-compose.yaml).
# Usually the same values as MINIO_ACCESS_KEY / MINIO_SECRET_KEY for local dev.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# --- Optional third-party APIs ---
# API_FOOTBALL_KEY=your-key-here
